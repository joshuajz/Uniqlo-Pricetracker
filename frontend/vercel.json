{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/page.ts": { "includeFiles": "dist/index.html" } },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "base-uri 'self'; frame-ancestors 'none'; object-src 'none'" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "rewrites": [
    {"source": "/", "destination": "/api/page?path=/"},
    {"source": "/:page(categories|dashboard|faq|terms|privacy)", "destination": "/api/page?path=/:page"},
    {"source": "/products/:id", "destination": "/api/page?path=/products/:id"},
    {"source": "/:market(ca|us|uk|jp|gb)", "destination": "/api/page?path=/:market"},
    {"source": "/:market(ca|us|uk|jp|gb)/:path*", "destination": "/api/page?path=/:market/:path*"},
    {"source": "/:path((?!assets/|api/|flags/|.*\\.[^/]+$).*)", "destination": "/api/page?path=/:path"}
  ]
}
